# Anything a gate compares byte-for-byte must check out with LF. Without this,
# autocrlf rewrites the file on checkout and every regeneration reports a
# whole-file diff that has nothing to do with its contents.

# Generated index artifacts, compared by the staleness gate.
/index/*.json text eol=lf
/index/*.jsonl text eol=lf

