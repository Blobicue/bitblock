# Multi-validator HA reverse proxy for native localhost Bitblock L1 Bits testnet (no Docker).
#
# - Listens on 127.0.0.1:8640 (target for Cloudflare Tunnel https://testnet-rpc.gameladder.io).
# - Routes both `/` and `/bits-shadow/*` (prefix-stripped) to local validators 127.0.0.1:8645..8648.
# - Primary-with-failover (`lb_policy first`) keeps consecutive proof reads monotonic while
#   failing over cleanly to node-1..3 if node-0 restarts.
# - Retries idempotent reads and signed `POST /tx`; excludes non-idempotent `POST /faucet`.
{
	auto_https off
	admin off
}

127.0.0.1:8640 {
	request_body {
		max_size 64KB
	}

	handle_path /bits-shadow/* {
		reverse_proxy 127.0.0.1:8645 127.0.0.1:8646 127.0.0.1:8647 127.0.0.1:8648 {
			lb_policy first
			request_buffers 64KB
			lb_retries 3
			lb_retry_match {
				expression `{method} in ['GET', 'HEAD', 'OPTIONS'] || ({method} == 'POST' && {path} == '/tx')`
			}
			lb_try_duration 4s
			lb_try_interval 150ms
			health_uri /health
			health_interval 2s
			health_timeout 1s
			fail_duration 10s
			max_fails 1
			transport http {
				dial_timeout 1s
				response_header_timeout 8s
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8645 127.0.0.1:8646 127.0.0.1:8647 127.0.0.1:8648 {
			lb_policy first
			request_buffers 64KB
			lb_retries 3
			lb_retry_match {
				expression `{method} in ['GET', 'HEAD', 'OPTIONS'] || ({method} == 'POST' && {path} == '/tx')`
			}
			lb_try_duration 4s
			lb_try_interval 150ms
			health_uri /health
			health_interval 2s
			health_timeout 1s
			fail_duration 10s
			max_fails 1
			transport http {
				dial_timeout 1s
				response_header_timeout 8s
			}
		}
	}
}
