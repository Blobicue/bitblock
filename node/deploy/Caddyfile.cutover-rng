# Phase 2 Cutover Caddyfile for rng-rpc-lb — SHADOW / ROLLBACK MODE.
#
# - Root `/` stays 100% on legacy rng-node-0..3:8545 (hot fallback).
# - Prefix `/bits-shadow/*` proxies (prefix-stripped) to merged Bitblock bb-rpc-lb:8645
#   so Gameladder can verify live behind its soft-launch gate BEFORE `/` ever flips.
# - Container-local `admin localhost:2019` (never exposed to host or tunnel) enables
#   zero-drop `<50ms` `caddy reload` with zero cloudflared restart and zero DNS changes.
{
	auto_https off
	admin localhost:2019
}

:8545 {
	request_body {
		max_size 64KB
	}

	handle_path /bits-shadow/* {
		reverse_proxy bb-rpc-lb:8645 {
			request_buffers 64KB
			lb_retries 2
			lb_retry_match {
				expression `{method} in ['GET', 'HEAD', 'OPTIONS'] || ({method} == 'POST' && {path} == '/tx')`
			}
			lb_try_duration 3s
			lb_try_interval 150ms
			transport http {
				dial_timeout 1s
				response_header_timeout 8s
			}
		}
	}

	handle {
		reverse_proxy node-0:8545 node-1:8545 node-2:8545 node-3:8545 {
			lb_policy first
			request_buffers 64KB
			lb_retries 3
			lb_retry_match {
				expression `{method} in ['GET', 'HEAD', 'OPTIONS'] || ({method} == 'POST' && {path} == '/tx')`
			}
			lb_try_duration 4s
			lb_try_interval 150ms
			health_uri /health
			health_interval 2s
			health_timeout 1s
			fail_duration 10s
			max_fails 1
			transport http {
				dial_timeout 1s
				response_header_timeout 8s
			}
		}
	}
}
